rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    /* ==================================================
       Access control (VibeSec):
       - Content is public-read (the live site renders it).
       - Writes are restricted to the admin email,
         never "any signed-in user".
       - Messages are readable/manageable by the admin only;
         anyone may submit a validated message.
       ================================================== */

    function isAdmin() {
      return request.auth != null
        && request.auth.token.email == 'zandf211@gmail.com';
    }

    /* ==================================================
       Site content (written by the Admin Dashboard).
       Publicly readable. Writable only by the verified
       admin, and only as well-formed content.
       The "site" doc holds the landing-page content;
       "policy" holds the privacy-policy page content.
       ================================================== */
    match /content/{docId} {
      allow read: if true;
      allow write: if isAdmin() && (
        docId == 'site' && isValidContent(request.resource.data)
        || docId == 'policy' && isValidPolicy(request.resource.data)
      );
    }

    /* ==================================================
       Contact messages (from the "Get in Touch" form).
       Anyone can submit a validated message. Only the
       admin can read, update, or delete them.
       ================================================== */
    match /messages/{messageId} {
      allow create: if isValidMessage(request.resource.data);
      allow read, update, delete: if isAdmin();
    }

    /* ==================================================
       Shared validation helpers
       ================================================== */

    function isNonEmptyString(value, maxLen) {
      return value is string
        && value.size() > 0
        && value.size() <= maxLen;
    }

    function isValidMessage(data) {
      return data is map
        && isNonEmptyString(data.name, 80)
        && isNonEmptyString(data.email, 80)
        && data.email.matches('^[^@\\s]+@[^@\\s]+\\.[^@\\s]+$')
        && data.message is string
        && data.message.size() >= 1
        && data.message.size() <= 4000
        && data.keys().hasOnly(['name', 'email', 'phone', 'service', 'message', 'createdAt']);
    }

    /* Content is a free-form map rendered safely via textContent +
       output-encoding in the loaders, so we enforce shape + size limits
       (defense in depth) rather than a rigid schema. */
    function isValidText(value, maxLen) {
      return value is string && value.size() <= maxLen;
    }

    function isValidList(value) {
      return value is list && value.size() <= 50;
    }

    function isValidContent(data) {
      return data is map
        && data.keys().size() <= 12
        && data.get('hero', {}).size() <= 8
        && data.get('about', {}).size() <= 6
        && data.get('contact', {}).size() <= 4
        && isValidList(data.get('services', []))
        && isValidList(data.get('projects', []))
        && isValidList(data.get('testimonials', []))
        && isValidList(data.get('socials', []))
        && isValidText(data.get('hero', {}).get('title', ''), 200)
        && isValidText(data.get('hero', {}).get('gradientText', ''), 200)
        && isValidText(data.get('hero', {}).get('description', ''), 500)
        && isValidText(data.get('about', {}).get('subtitle', ''), 500);
    }

    function isValidPolicy(data) {
      return data is map
        && data.keys().hasOnly(['title', 'intro', 'updatedAt', 'sections'])
        && isValidText(data.get('title', ''), 80)
        && isValidText(data.get('intro', ''), 500)
        && isValidText(data.get('updatedAt', ''), 40)
        && data.get('sections', []) is list
        && data.get('sections', []).size() <= 30;
    }
  }
}
