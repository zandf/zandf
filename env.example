# Copy this file to .env and fill in your real values.
# NEVER commit .env — it is gitignored.

# EmailJS — https://www.emailjs.com
EMAILJS_PUBLIC_KEY=your_public_key
EMAILJS_PRIVATE_KEY=your_private_key
EMAILJS_SERVICE_ID=your_service_id
EMAILJS_TEMPLATE_ID=your_template_id

# Cloudinary — https://cloudinary.com
# The cloud name + unsigned upload preset are public by design (no secret needed
# for unsigned client-side uploads). The upload preset must allow unsigned uploads.
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_UPLOAD_PRESET=your_upload_preset

# Firebase — web app config (public values, safe to ship to the browser).
# Get these from Firebase Console > Project settings > General > Your apps.
FIREBASE_API_KEY=your_api_key
FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
FIREBASE_PROJECT_ID=your_project_id
FIREBASE_STORAGE_BUCKET=your_project.appspot.com
FIREBASE_MESSAGING_SENDER_ID=your_sender_id
FIREBASE_APP_ID=your_app_id
FIREBASE_MEASUREMENT_ID=your_measurement_id

# Email of the Firebase Auth account allowed to sign into the Admin Dashboard.
# Create this user in Firebase Console > Authentication > Users.
FIREBASE_ADMIN_EMAIL=you@example.com
